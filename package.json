{
  "name": "create-content-monorepo",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/modules/*",
    "packages/persistence-utils",
    "packages/query-builder",
    "core/*",
    "services/*"
  ],
  "scripts": {
    "dev:backend": "bash scripts/start-backend.sh",
    "dev:local": "cd create-content-web-app && VITE_PROXY_TARGET=http://127.0.0.1:3100 vite",
    "build": "cd create-content-web-app && vite build",
    "build-schema": "node scripts/build-schema.js",
    "migrate:status": "node scripts/apply-migrations.mjs --status",
    "migrate": "node scripts/apply-migrations.mjs --pending",
    "check:llm": "node scripts/check-llm-providers.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"./**/*.{js,jsx,json,css,scss,md}\"",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "test:fast": "TEST_REUSE_DB=1 node --experimental-vm-modules node_modules/.bin/jest",
    "test:backend": "node --experimental-vm-modules node_modules/.bin/jest --selectProjects backend",
    "test:web": "node --experimental-vm-modules node_modules/.bin/jest --selectProjects web",
    "test:packages": "node --experimental-vm-modules node_modules/.bin/jest --testPathPattern=packages/.*/__tests__",
    "test:refresh-schema": "TEST_DB_REFRESH=1 node --experimental-vm-modules node_modules/.bin/jest",
    "test:e2e": "node e2e/run.js",
    "gen:table-defs": "node scripts/gen-table-definitions.mjs"
  },
  "prettier": {
    "singleQuote": true
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@faker-js/faker": "^10.6.0",
    "@mozilla/readability": "^0.6.0",
    "@mui/material": "^7.3.11",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.104.1",
    "12factor-config": "^2.0.0",
    "axios": "^1.20.0",
    "body-parser": "^2.3.0",
    "classnames": "^2.5.1",
    "compression": "^1.8.2",
    "dayjs": "^1.11.23",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "jsdom": "^26.1.0",
    "lodash": "^4.18.1",
    "mermaid": "^12.1.0",
    "node-cron": "^4.6.0",
    "notistack": "^3.0.2",
    "openai": "^7.28.0",
    "pg": "^8.23.1",
    "puppeteer": "^25.12.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.5",
    "swagger-ui-express": "^5.0.1",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@eslint/js": "^9.39.5",
    "@jest/globals": "^29.7.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-jest": "^29.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.9.9",
    "sass-embedded": "^1.105.1",
    "supertest": "^7.3.1",
    "vite": "^8.3.2"
  }
}
