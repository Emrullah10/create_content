# Kopyala: cp .env.example .env

# App
NODE_ENV=development
LOG_LEVEL=info
PORT=3100

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=create_content
POSTGRES_PASSWORD=create_content_dev
POSTGRES_DB=create_content

# AI Service (create-content-ai / FastAPI)
AI_API_URL=http://localhost:8100/api/v1/ai
NVIDIA_API_KEY=your-nvidia-api-key-here
NVIDIA_TEXT_MODEL=meta/llama-3.3-70b-instruct
IMAGE_ENDPOINT=https://image.pollinations.ai/prompt

# dev.to
DEVTO_API_KEY=
DEVTO_PUBLISH_MODE=draft

# Medium (opsiyonel — bos ise import akisina duser)
MEDIUM_INTEGRATION_TOKEN=

# Gorsel host (ayri public repo)
GITHUB_TOKEN=
GITHUB_ASSETS_REPO=your-username/content-assets
GITHUB_ASSETS_BRANCH=main

# Icerik ayarlari
CONTENT_LANGUAGE=en
QUALITY_THRESHOLD=75
DAILY_CRON=0 6 * * *
TOPIC_QUEUE_MIN=10
