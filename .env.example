# Kopyala: cp .env.example .env

# ── Servis (port bu URL'den turetilir; 127.0.0.1'e baglanir) ───────────────────
NODE_ENV=development
SERVICE_CONTENT_REST_URL=http://127.0.0.1:3100
# Panel Vite adresi (unsafe method'larda Origin kontrolu). Virgulle ayir.
PANEL_ORIGINS=http://127.0.0.1:5174,http://localhost:5174
# DISABLE_CRON=true   # cron'u kapatir

# ── Veritabani (native PostgreSQL 15, Docker YOK) ─────────────────────────────
CORE_APP_DB_CONNECTION_STRING=postgres://create_content:create_content_dev@127.0.0.1:5432/create_content
# Migration icin farkli (yetkili) rol gerekirse. Bos ise yukaridaki kullanilir.
# MIGRATION_DB_CONNECTION_STRING=

# ── LLM rolleri: her rol OpenAI-uyumlu bir uc nokta. Bos birakilan rol writer'a duser ──
# writer: makale yazar. judge: mumkunse farkli bir model. utility: kisa isler (konu benzerligi, diyagram onarimi).
LLM_WRITER_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_WRITER_API_KEY=your-nvidia-api-key-here
# NVIDIA'da meta/llama-3.3-70b-instruct 2026-08-26'da kaldirildi (HTTP 410). Hesabinda GERCEKTEN erisilebilir modelleri `npm run check:llm` ile dogrula.
LLM_WRITER_MODEL=nvidia/nemotron-3-ultra-550b-a55b
LLM_WRITER_JSON_MODE=json_object
# Saglayiciya ozel istek alanlari (JSON). NIM'de dusunmeyi kapatmak: {"chat_template_kwargs":{"enable_thinking":false}}
# LLM_WRITER_EXTRA_BODY=
# LLM_WRITER_CONTEXT=32768
# LLM_WRITER_TIMEOUT_MS=300000
# LLM_JUDGE_BASE_URL=
# LLM_JUDGE_API_KEY=
LLM_JUDGE_MODEL=nvidia/nemotron-3-super-120b-a12b
# Yerel Ollama: ollama pull qwen3:8b, OLLAMA_CONTEXT_LENGTH=16384 ile baslat
# LLM_UTILITY_BASE_URL=http://127.0.0.1:11434/v1
# LLM_UTILITY_API_KEY=ollama
LLM_UTILITY_MODEL=nvidia/nemotron-3-super-120b-a12b
# Mekanik isler (olgu cikarma, kod/diyagram onarimi) dusunmeye ihtiyac duymaz: daha hizli ve ucuz
LLM_UTILITY_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}
# LLM_UTILITY_MODEL=qwen3:8b   (yerel Ollama kullanirsan; asagidaki BASE_URL/API_KEY/JSON_MODE ile birlikte)
# LLM_UTILITY_JSON_MODE=json_schema
# Sahte saglayici (test/E2E): LLM_PROVIDER=fake. Uretimde REDDEDILIR.
# LLM_PROVIDER=

# ── Kapak gorseli (Cloudflare Workers AI, flux-1-schnell) ──────────────────────
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id-here
CLOUDFLARE_API_TOKEN=your-cloudflare-workers-ai-token-here

# ── Gorsel host (ayri public GitHub repo) ─────────────────────────────────────
GITHUB_TOKEN=
GITHUB_ASSETS_REPO=your-username/content-assets
GITHUB_ASSETS_BRANCH=main

# ── Yayin ─────────────────────────────────────────────────────────────────────
DEVTO_API_KEY=
# draft | live. Ilk hafta draft kal.
DEVTO_PUBLISH_MODE=draft
# PUBLISHER_PROVIDER=fake   # test/E2E: uretimde REDDEDILIR

# ── Icerik ayarlari ──────────────────────────────────────────────────────────
CONTENT_LANGUAGE=en
QUALITY_THRESHOLD=75
QUALITY_MAX_ROUNDS=2
# Skor QUALITY_THRESHOLD altindaysa: hakem elestirisine gore bolumleri yeniden yaz + yeniden puanla (tur sayisi; 0 = kapali).
# Her tur ~1 + (yeniden yazilan bolum) + JUDGE_SAMPLES LLM cagrisi; puan artmazsa eski surume donulur.
QUALITY_IMPROVE_ROUNDS=2
DAILY_CRON=0 6 * * *
TOPIC_SUGGESTED_MAX=15

# ── Panel girisi (sunucuya acarken ZORUNLU say) ─────────────────────────────────
# Bos ise giris yok (yerel gelistirme). Doluysa tum /api oturum ister; cerez 7 gun gecerli.
# PANEL_PASSWORD=
# PANEL_SESSION_SECRET=   # bos ise paroladan turetilir; ayri bir rastgele deger onerilir (degisirse tum oturumlar duser)
# Alan adi arkasinda: nginx Host'u oldugu gibi iletmeli (proxy_set_header Host $host)
# ALLOWED_HOSTS=panel.example.com
# PANEL_ORIGINS=https://panel.example.com
